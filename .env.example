# DisasterGuard AI - Environment Configuration Example
# Backend Port & Host
HOST=0.0.0.0
PORT=8000

# Database Configuration (Defaults to SQLite for local hackathon demo, switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./disasterguard.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/disasterguard

# Optional LLM Reasoning Engine (Google Gemini / OpenAI)
# If left blank, the built-in deterministic multi-agent inference engine runs offline with 100% reliability
GEMINI_API_KEY=
OPENAI_API_KEY=

# Emergency SMS Gateway Abstraction
SMS_MOCK_MODE=true
SMS_API_KEY=
SMS_SENDER_ID=NDMA-IN

# Frontend Environment (in frontend/.env)
VITE_API_BASE=http://localhost:8000
